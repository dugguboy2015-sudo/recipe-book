# Copy to .env.local (gitignored) and fill in. Never paste these into chat or commit them.
# The agent reads .env.local; it generates .dev.vars for local Functions from it.

# ---- Supabase ---------------------------------------------------------------
# Project ref: xtxufygmwqicrgzjwdxc
# Dashboard > Project Settings > API Keys > "Secret keys" (starts sb_secret_)
SUPABASE_SECRET_KEY=
# supabase.com/dashboard/account/tokens (used ONLY for running migrations)
SUPABASE_ACCESS_TOKEN=

# ---- Cloudflare -------------------------------------------------------------
# Account 913933566e3811466a563918f9f9655e, Pages project recipe-book
# Custom token: Pages Edit, Workers AI Edit, Account Settings Read, Turnstile Edit (optional),
#               User Details Read, Memberships Read
CLOUDFLARE_API_TOKEN=

# ---- Turnstile (managed widget for recipe-book-9eo.pages.dev) ---------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Optional fallback model (aistudio.google.com/apikey) --------------------
GEMINI_API_KEY=

# ---- Decisions ---------------------------------------------------------------
LOCKDOWN_IN_PHASE_0=true        # block direct anonymous writes immediately (missing = true)
AGENT_MAY_MERGE_TO_MAIN=true    # agent merges its own PRs = production deploy (missing = true)
GEN_GLOBAL_DAILY=18             # AI model calls per UTC day, whole site (~500 neurons each)
GEN_PER_IP_DAILY=5              # AI model calls per visitor per UTC day
WRITES_PER_IP_HOURLY=30         # create/edit/delete per visitor per hour
ENABLE_SHOPPING_LIST=false      # true = also build the optional shopping list (Phase 14)
